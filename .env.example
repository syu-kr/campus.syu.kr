# ============================================================================
# Environment Variables Configuration
# Copy this file to .env.local and fill in your values
# ============================================================================

# ============================================================================
# Optional search engine ownership verification (Server-side)
# Copy only the content value from the verification meta tag, not the whole tag.
# Empty values omit the tag. Values are public in the initial HTML head.
# Register on Vercel Production and redeploy after changing them.
# See docs/SEARCH_INDEXING_GUIDE.md for setup and sitemap submission.
# ============================================================================
NAVER_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ============================================================================
# Kakao Maps API
# Get API key from: https://developers.kakao.com/
# Register http://localhost:3000 and https://campus.syu.kr in this JavaScript key's SDK domains.
# Custom hostnames or ports need their own SDK domain registration.
# ============================================================================
NEXT_PUBLIC_KAKAO_MAP_KEY=your_kakao_map_api_key_here

# ============================================================================
# Sentry Error Monitoring
# NEXT_PUBLIC_SENTRY_DSN is intentionally public and is included in browser bundles.
# Events require a production build and Vercel production/preview environment
# (VERCEL_ENV on the server, NEXT_PUBLIC_VERCEL_ENV in the browser).
# Local development and test runs do not send events.
# SENTRY_AUTH_TOKEN is a build-only secret for source map uploads. Never commit it
# or prefix it with NEXT_PUBLIC_. Register the real value only in Vercel/CI.
# Use a separate read-only token outside this app environment for issue inspection.
# ============================================================================
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=singhic-eu
SENTRY_PROJECT=javascript-nextjs
SENTRY_AUTH_TOKEN=

# ============================================================================
# Server-side external API settings
# Keep these values on the server. Do not prefix them with NEXT_PUBLIC_.
# Register the same values in Vercel Project Environment Variables.
# ============================================================================
PUBLIC_DATA_SERVICE_KEY=your_public_data_service_key_here
# Enable holiday collection only after the compatible application is deployed.
PUBLIC_HOLIDAYS_ENABLED=false
KMA_NCST_URL=your_kma_ultra_short_nowcast_endpoint
KMA_FCST_URL=your_kma_ultra_short_forecast_endpoint
SEOUL_BUS_ARRIVAL_URL=your_seoul_bus_arrival_endpoint
GYEONGGI_BUS_ARRIVAL_URL=your_gyeonggi_bus_arrival_endpoint
SHUTTLE_LOCATION_URL=
SHUTTLE_PAGE_URL=
SHUTTLE_REFERER=
SHUTTLE_USER_AGENT=
SHUTTLE_CHALLENGE_SALT=
SHUTTLE_TRACE_HEADER_COMPAT_HOST=
LECTURE_TIMETABLE_URL=your_lecture_timetable_endpoint
LIBRARY_READING_ROOMS_URL=your_library_reading_rooms_endpoint

# ============================================================================
# OpenAI announcement summary (Server-side)
# Used by server-side AI features and scripts.
# Use separate service-account keys for GitHub Actions and Vercel.
# ============================================================================
OPENAI_API_KEY=your_openai_project_api_key
OPENAI_ANNOUNCEMENT_MODEL=gpt-5.6-luna
ANNOUNCEMENT_AI_ENABLED=true
ANNOUNCEMENT_AI_LIMIT=25
ANNOUNCEMENT_AI_DELAY_MS=2200
ANNOUNCEMENT_AI_TIMEOUT_MS=30000
ANNOUNCEMENT_AI_CHECKPOINT_EVERY=5
ANNOUNCEMENT_AI_MAX_RETRIES=3
ANNOUNCEMENT_AI_REFRESH_GENERATION=false
ANNOUNCEMENT_AI_REFRESH_SINCE=2026-01-01
ANNOUNCEMENT_DETAIL_FETCH_ENABLED=true
ANNOUNCEMENT_DETAIL_FETCH_TIMEOUT_MS=12000
ANNOUNCEMENT_DETAIL_CHANGE_CHECK_ENABLED=true
ANNOUNCEMENT_DETAIL_CHANGE_CHECK_LIMIT=25

# 만나의집 (기숙사 식당): HAKSIK_API_URL and OPENAI_API_KEY belong only in
# GitHub Actions Secrets. Do not register HAKSIK_API_URL in Vercel or browsers.
# The blank entry names the required Secret; never commit a real endpoint here.
HAKSIK_API_URL=
# Optional Actions Variable for image analysis; defaults to gpt-6.1-sol.
OPENAI_MODEL=gpt-6.1-sol
# Public Pages JSON only. Set this in Vercel and rebuild to enable 만나의집.
# Empty means collection has not been connected to the app yet.
NEXT_PUBLIC_CAFETERIA_JSON_URL=

# Public SW-centered university notice board page base URL.
CRAWL_SWUNIV_NOTICES_URL=

# ============================================================================
# AI assistant APIs (Server-side)
# ============================================================================
OPENAI_PUSH_MODEL=gpt-5.6-luna
PUSH_COPY_AI_ENABLED=true
PUSH_COPY_AI_TIMEOUT_MS=12000
PUSH_COPY_AI_MAX_RETRIES=2
OPENAI_ADMIN_MODEL=gpt-5.6-luna
ADMIN_CLASSIFIER_AI_ENABLED=true
ADMIN_CLASSIFIER_AI_TIMEOUT_MS=15000
ADMIN_CLASSIFIER_AI_MAX_RETRIES=2

# ============================================================================
# Firebase Configuration (Client-side)
# Get values from Firebase Console → Project Settings
# These values are PUBLIC and safe to expose to browser
# ============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ============================================================================
# Firebase Web Push (VAPID KEY)
# Used for web push notifications in service worker
# ============================================================================
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-public-key-here

# ============================================================================
# Firebase Admin SDK (Server-side)
# IMPORTANT: Keep this value SECRET - never commit to git
# Full JSON service account object as environment variable
# ============================================================================
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key":"..."}

# Optional server-only bucket override for administrator banner images.
# Otherwise NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET is used. The bucket must exist.
MANAGED_CONTENT_STORAGE_BUCKET=

# ============================================================================
# Push Notification API
# Internal API key for push notification authorization
# ============================================================================
PUSH_API_KEY=your_internal_push_notification_api_key

# Shared HMAC key for persistent API rate-limit document IDs.
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Required in production. Redeploy Vercel after adding or rotating it.
# Local development can fall back to PUSH_API_KEY.
RATE_LIMIT_SECRET=your_random_rate_limit_hmac_secret

# Optional inline translation of allowlisted public Korean content (server only).
# Enable Cloud Translation in your own project and restrict the key to that API.
# FIREBASE_SERVICE_ACCOUNT and RATE_LIMIT_SECRET above are also required for
# shared cache, request limiting, and the daily character reservation.
GOOGLE_TRANSLATION_API_KEY=
CONTENT_TRANSLATION_DAILY_CHARACTERS=25000

# Public content migration. Keep the current sources until import and DB-only
# comparisons pass; setting these flags does not import data or deploy the app.
# Server only: hybrid | database
SERVICE_NOTICES_SOURCE=hybrid
# Server only: pages | firebase. Set at build and runtime; URL rewrites need a rebuild.
PUBLIC_DATA_BACKEND=pages
# Optional snapshot bucket override. Falls back to MANAGED_CONTENT_STORAGE_BUCKET
# and then NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET. Use the bucket name without gs://.
PUBLIC_DATA_STORAGE_BUCKET=

# Dorm roommate board. Disabled until the test Firebase, email-link provider,
# authorized domains, delivery and moderation flow have been verified.
# Generate an independent random 32-byte secret per environment; never reuse keys.
ROOMMATES_OWNER_KEY_SECRET=
ROOMMATES_ENABLED=false
ROOMMATES_WRITES_ENABLED=false
ROOMMATES_EMAIL_ENABLED=false

# ============================================================================
# Admin access allowlist
# Server-only, comma-separated Firebase Auth UIDs from the matching project.
# UID matching is case-sensitive. Configure before deploying UID authorization.
# Required. Admin APIs return 503 when this value is empty. Email allowlists are ignored.
# ============================================================================
ADMIN_UIDS=

# ============================================================================
# Application URLs
# Set this for GitHub Actions and local notification tests.
# GitHub Actions must use a deployed HTTPS app URL, never localhost.
# ============================================================================
API_URL=http://localhost:3000

# For production/staging deployments:
# API_URL=https://campus.syu.kr

# ============================================================================
# Optional maintenance/build flags
# ============================================================================
TOKEN_CLEANUP_DAYS=90
ANALYZE=false

# ============================================================================
# Local crawler source URLs
# GitHub Actions should receive these through repository Actions Variables.
# Locally, set them in your shell before running crawler scripts.
# ============================================================================
CRAWL_ACADEMIC_NOTICES_URL=
CRAWL_SCHOLARSHIP_NOTICES_URL=
CRAWL_CAMPUS_NOTICES_URL=
CRAWL_SWUNIV_NOTICES_URL=
CRAWL_EVENT_NOTICES_URL=
CRAWL_DEPARTMENT_COURSE_GUIDE_URL=
CRAWL_DEPARTMENT_COLLEGE_EXCLUDE_URLS=
CRAWL_DEPARTMENT_NOTICE_QUERY_URLS=
CRAWL_DEPARTMENT_NOTICE_MAX_PAGES=3
CRAWL_DEPARTMENT_NOTICE_SEARCH_TERMS=공모,대회,경진,해커톤,데이터톤,아이디어톤,챌린지,콘테스트
CRAWL_DEPARTMENT_NOTICE_SEARCH_MAX_PAGES=2
CRAWL_DEPARTMENT_NOTICE_DELAY_SECONDS=0.25
CRAWL_CAFETERIA_URL=
CRAWL_PHONE_DIRECTORY_URL=
CRAWL_ACADEMIC_SCHEDULE_URL=
